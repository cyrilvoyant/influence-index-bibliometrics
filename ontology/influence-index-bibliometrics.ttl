:software a wsem:Software, schema:SoftwareSourceCode ;
    schema:name "Influence Index: a log-based measure of research influence for institutions (MATLAB, processed data)" ;
    schema:codeRepository <https://github.com/cyrilvoyant/influence-index-bibliometrics> ;
